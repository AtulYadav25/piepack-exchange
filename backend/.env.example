NODE_ENV=DEVELOPMENT
PORT=3000

# ─── Database ──────────────────────────────────────────────────────────────────
# Standard postgresql:// URL — used by both Prisma and the raw pg pool (TimescaleDB).
# Matches the docker-compose.yml service credentials (port 5433 on host).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/tradeapp"

# Docker Compose credentials (referenced in docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tradeapp

# ─── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BROKERS="localhost:9092"

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=supersecret_change_me_in_production_please
